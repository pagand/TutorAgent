# ============================================================
# .env.docker.example — copy to .env and fill in real values
# ============================================================

# --- Postgres (used by docker-compose to create the DB) ---
POSTGRES_USER=aitutor
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=aitutor_db

# DATABASE_URL is auto-constructed in docker-compose.yml from the vars above.
# Set it here only if you need to override (e.g. external managed DB).
# DATABASE_URL=postgresql+asyncpg://aitutor:change_me@db:5432/aitutor_db

# --- LLM Provider ---
LLM_PROVIDER=google
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL_NAME=gemini-2.5-flash-lite

# --- Embedding model (Google) ---
# Used for ChromaDB ingestion and retrieval. Requires Google billing enabled.
GOOGLE_EMBEDDING_MODEL_NAME=models/gemini-embedding-001

# --- CORS ---
# REQUIRED for production — set to your CloudFront domain (no trailing slash).
# Example: ALLOWED_ORIGIN=https://d1234abcd.cloudfront.net
# The placeholder below matches no real Origin header, so an operator who
# copies this file without editing it gets a loud, visible CORS failure in
# the browser during smoke testing — not a silent open-CORS deployment.
# Set to "*" explicitly (disables credentials) only for local dev.
ALLOWED_ORIGIN=REPLACE_WITH_CLOUDFRONT_DOMAIN

# --- LLM Cache ---
# Set to false to disable SQLite-backed hint caching (not recommended in prod).
USE_LLM_CACHE=true

# --- Exam Timer (ms) ---
EXAM_DURATION_MS=1500000

# --- Logging ---
LOG_LEVEL=INFO

# --- API Key (obscurity, not secrecy — see app/utils/config.py) ---
# Empty/unset disables the check entirely (dev/E2E default). Left blank here
# on purpose: a placeholder value would enable the middleware with a secret
# the frontend's NEXT_PUBLIC_API_KEY build var doesn't know, 401-ing every
# request. Set both to the same value when you actually want it enabled.
API_KEY=

# --- File Paths (inside container — do not change unless you update volumes) ---
QUESTION_CSV_FILE_PATH=prod/data/server_ready_questions.csv
PDF_PATH=prod/data/source.pdf
