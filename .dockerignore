# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test & coverage artifacts
.pytest_cache/
.coverage
htmlcov/
*.db
aistutor.db
aitutor.db

# Local dev databases & caches
chroma_db/
chroma_db_old/

# Frontend - the backend image never needs any of it, and frontend/e2e/fixtures/
# includes a direct answer-key oracle (answer_key.py) that must never end up
# baked into a shippable image layer.
frontend/

# Dev/eval question sets - carry a correct_answer column in the clear.
# Production reads only prod/data/ (mounted read-only, see below).
data/

# Git
.git/
.gitignore

# Secrets — never bake into image
.env

# Docs & notebooks
*.md
docs/
evaluation/

# Production data — answer key and participant tokens; arrives via bind mount only
prod/data/

# EC2 runtime-selected nginx config and certbot state — never committed,
# rendered/populated by scripts/ec2-bootstrap.sh. certbot writes root-owned
# files here on the host, which the non-root docker build client can't read
# as part of the build context once they exist — every `docker compose
# build` after the first certbot run would fail without this exclusion.
nginx/conf.d/
certbot/
certbot-www/

# OS
.DS_Store
Thumbs.db
