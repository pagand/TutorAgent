# Copy to terraform.tfvars (gitignored) and adjust if needed.
# All values below are the recorded defaults - only override if you're
# deliberately deviating from the signed-off plan.

aws_profile = "AdministratorAccess-434195712367"

domain_frontend = "air.da-tu.ca"
domain_api      = "api.air.da-tu.ca"

