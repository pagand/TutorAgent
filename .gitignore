.venv/
.env
.env.*
!.env.example
!.env.docker.example
*.pem
*.key

# IDE and OS files
.vscode/
.idea/
*.swp
.DS_Store

# Compiled Python files
*__pycache__*
*.pyc
*.pyo

*.log

# --- Databases and Data Stores ---
chroma_db*          
*.sqlite
*.sqlite3
*.db
*_cache.json

.pytest_cache*
results*
!frontend/src/app/results/
!frontend/e2e/results-cross-device.spec.ts
plots*

# Production data — contains exam questions and participant tokens (never commit)
prod/data/

# DB backups (scripts/backup.sh) — full data dumps, same sensitivity as prod/data/
backups/

# Terraform (Stage 4) — state and vars carry account IDs / resource ARNs.
# terraform.lock.hcl is NOT ignored - it pins provider versions and should
# be committed, per standard Terraform practice.
terraform/.terraform/
terraform/*.tfstate*
terraform/*.tfvars
terraform/*.tfplan

# EC2 runtime-selected nginx config — never committed, rendered by
# scripts/ec2-bootstrap.sh on every boot.
nginx/conf.d/

# Local planning and design docs, never tracked.
# All of these except CLAUDE.md were superseded by PRELAUNCH_CHECKLIST.md,
# which is now the single tracker for outstanding work, and were moved to
# docs/archive/ on 2026-08-04. Their filenames stay listed so a stray copy
# at the repo root is still ignored if one ever reappears.
docs/archive/
DEVELOPMENT_PLAN.md
ARCHITECTURE.md
TESTING_STRATEGY.md
IMPROVEMENT.md
LLMaS_plan.md
Plan_Profile-Centric_FrontEnd.md
CLAUDE.md
progress.md


# Claude Code local config, skills and agent scratch - never tracked,
# same rule as CLAUDE.md and the other local planning docs above.
.claude/
